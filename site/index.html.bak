<!DOCTYPE html><html lang="fr" class="dark" style="color-scheme: dark" dir="ltr"><head>
    <!-- prerendu-katech / -->
    <meta charset="UTF-8">
    <base href="/">
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
    <!-- Icônes : chemins ABSOLUS à la source, car c'est la seule forme que Vite
         sait réécrire selon `base` (vérifié : `--base=/boutique/` produit bien
         « /boutique/favicon.ico »). Les écrire relatifs les soustrairait à ce
         mécanisme ET les casserait sur les routes profondes de la SPA, où
         « ./favicon.ico » se résoudrait contre /produits/xyz/. -->
    <!-- Le .ico reste déclaré en premier : c'est le seul repli universel, et
         c'est aussi ce que les navigateurs vont chercher à la racine sans lien. -->
    <link rel="icon" href="./favicon.ico?v=3" sizes="any">
    <link rel="icon" href="./favicon.png?v=3" type="image/png">
    <link rel="icon" href="./favicon.svg?v=3" type="image/svg+xml">
    <!-- iOS ignore le manifeste et le SVG : il lui faut son PNG opaque. -->
    <link rel="apple-touch-icon" href="./apple-touch-icon.png?v=3">
    <link rel="manifest" href="./manifest.webmanifest">
    <meta name="theme-color" content="#0a0d12">
    <title>KA Tech — La puissance tech entre vos mains</title>
    
    <meta name="author" content="KA Tech">
    <meta property="og:title" content="KA Tech — La puissance tech entre vos mains">
    <meta property="og:description" content="Ordinateurs, configurations et smartphones avec garantie officielle et livraison partout en Algérie.">
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="KA Tech">
    <meta property="og:locale" content="fr_DZ">
    <!-- WhatsApp — canal de vente principal en Algérie — n'accepte QUE des URL
         absolues pour og:image : un chemin relatif ne produit aucune vignette.
         Les URL ci-dessous sont des valeurs de REPLI : elles restent correctes
         sur le domaine de production (katech.dz). Quand le site est servi par
         public/index.php (cas normal), PHP les réécrit à la volée avec l'origine
         réelle de la requête (protocole + hôte), ce qui les rend portables sur
         tout hébergement ou sous-domaine sans reconstruire. -->
    
    <meta property="og:image" content="https://katech.dz/og-image.png">
    <meta property="og:image:type" content="image/png">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="KA Tech — La technologie entre vos mains">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="KA Tech">
    <meta name="twitter:description" content="Ordinateurs, configurations et smartphones avec garantie officielle en Algérie.">
    <meta name="twitter:image" content="https://katech.dz/og-image.png">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="">
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Sora:wght@400;500;600;700;800&amp;family=Inter:wght@400;500;600;700&amp;display=swap">
